# ==============================================================================
# Production JVM Tuning Options Reference for OpenShift / RHEL Containers
# Optimized for Spring Boot Microservices (e.g. ResilientFulfillmentService)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Container Memory Boundaries (Avoid OOMKilled by OpenShift cgroups)
# ------------------------------------------------------------------------------
# In containerized environments, avoid hardcoded -Xms/-Xmx; use RAM percentages.
JVM_CONTAINER_OPTS="\
-XX:+UseContainerSupport \
-XX:MaxRAMPercentage=75.0 \
-XX:InitialRAMPercentage=50.0 \
-XX:MinRAMPercentage=50.0 \
-XX:+ExitOnOutOfMemoryError \
-XX:+CrashOnOutOfMemoryError \
-XX:HeapDumpPath=/var/log/jvm/dumps/heapdump-%p-%t.hprof \
-XX:+HeapDumpOnOutOfMemoryError"

# ------------------------------------------------------------------------------
# 2. Garbage Collector Profile: G1GC (Throughput + Predictable Pause < 100ms)
# ------------------------------------------------------------------------------
JVM_G1GC_OPTS="\
-XX:+UseG1GC \
-XX:MaxGCPauseMillis=100 \
-XX:InitiatingHeapOccupancyPercent=45 \
-XX:G1ReservePercent=15 \
-XX:G1HeapRegionSize=16m \
-XX:ParallelGCThreads=4 \
-XX:ConcGCThreads=2 \
-XX:+ParallelRefProcEnabled \
-XX:G1PeriodicGCInterval=60000"

# ------------------------------------------------------------------------------
# 3. Garbage Collector Profile: Generational ZGC (Ultra-Low Pause < 1ms, Java 21+)
# ------------------------------------------------------------------------------
JVM_ZGC_OPTS="\
-XX:+UseZGC \
-XX:+ZGenerational \
-XX:ZAllocationSpikeTolerance=5"

# ------------------------------------------------------------------------------
# 4. High-Precision GC Logging for Splunk Log Digestion
# ------------------------------------------------------------------------------
JVM_LOGGING_OPTS="\
-Xlog:gc*,gc+phases=debug:file=/var/log/jvm/gc-%t.log:time,uptime,pid:filecount=5,filesize=50M \
-Djava.security.egd=file:/dev/./urandom \
-Dspring.jmx.enabled=true"
